# Supabase (get from supabase.com → project settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat (get from app.revenuecat.com)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_...
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_...

# n8n content-ingestion webhook (see n8n/README.md). If unset, the app falls
# back to the process-save-item Supabase Edge Function.
EXPO_PUBLIC_N8N_SAVE_WEBHOOK_URL=https://your-n8n.up.railway.app/webhook/savebot-ingest
