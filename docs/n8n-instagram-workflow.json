        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"directUrls\": [\"{{ $json.body.url }}\"],\n  \"resultsType\": \"posts\",\n  \"resultsLimit\": 1,\n  \"addParentData\": false\n}",
        "options": {}
      },
      "id": "b1a1e001-0001-4001-8001-000000000002",
      "name": "Apify Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Apify returns the scraped post(s). Handle both shapes (array in one item,\n// or split into items) and map to the contract SaveBot expects.\nconst first = $input.first().json;\nconst post = Array.isArray(first) ? (first[0] || {}) : first;\n\n// Collect EVERY slide image — a carousel/sidecar post has many, and its text\n// usually spans all of them, so SaveBot OCRs each one.\nconst images = [];\nconst push = (u) => { if (typeof u === \"string\" && u.startsWith(\"http\")) images.push(u); };\nif (Array.isArray(post.images)) post.images.forEach(push);\nif (Array.isArray(post.childPosts)) post.childPosts.forEach((c) => push(c.displayUrl));\npush(post.displayUrl);\nconst uniqueImages = [...new Set(images)];\n\nreturn [{ json: {\n  caption: post.caption || \"\",\n  author: post.ownerFullName || post.ownerUsername || \"\",\n  thumbnail_url: post.displayUrl || uniqueImages[0] || \"\",\n  video_url: post.videoUrl || post.videoUrlHd || \"\",\n  images: uniqueImages\n} }];"
      },
      "id": "b1a1e001-0001-4001-8001-000000000003",
      "name": "Map fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
