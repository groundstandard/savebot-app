      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map((i) => i.json);\n// Some runs return one item that is itself an array of posts.\nconst posts = items.length === 1 && Array.isArray(items[0]) ? items[0] : items;\nconst main = posts[0] || {};\n\n// Collect EVERY slide image across every returned post/child.\nconst images = [];\nconst push = (u) => { if (typeof u === \"string\" && u.startsWith(\"http\")) images.push(u); };\nfor (const post of posts) {\n  if (Array.isArray(post.images)) post.images.forEach(push);\n  if (Array.isArray(post.childPosts)) post.childPosts.forEach((c) => push(c.displayUrl));\n  push(post.displayUrl);\n}\nconst uniqueImages = [...new Set(images)];\n\nreturn [{ json: {\n  caption: main.caption || \"\",\n  author: main.ownerFullName || main.ownerUsername || \"\",\n  thumbnail_url: main.displayUrl || uniqueImages[0] || \"\",\n  video_url: main.videoUrl || main.videoUrlHd || \"\",\n  images: uniqueImages\n} }];"
      },
